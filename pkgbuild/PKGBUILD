pkgname=gus
pkgver=0.2.0
pkgrel=1
pkgdesc='Gus pops up at the bottom of your screen and farts when you click him'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'quickshell' 'pipewire-audio')
makedepends=('gcc' 'make' 'python')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/gus "$pkgdir/usr/bin/gus"
  install -Dm644 -t "$pkgdir/usr/share/gus/overlay" build/overlay/*.qml
  install -Dm644 -t "$pkgdir/usr/share/gus/overlay/sounds" build/overlay/sounds/*.wav
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/gus.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/gus.svg"
  install -Dm644 "$startdir/gus.desktop" "$pkgdir/usr/share/applications/gus.desktop"
}
